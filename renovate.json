{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>carstencodes/.shared//renovate/conventional"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update docker images files",
      "managerFilePatterns": [
        "deps/Docker.Images.props"
      ],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? -->\\s+<[^>]+>(?<packageName>[^:]+?):(?<currentValue>\\d+(\\.\\d+)*(-[0-9a-zA-z\\.]+)?)</[^>]+>"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "postUpdateOptions": [
        "nugetUpdateLockFiles"
      ]
    }
  ]
}
