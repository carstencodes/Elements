{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>carstencodes/.shared//renovate/conventional"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update cargo tools",
      "managerFilePatterns": [
        "deps/cargo-tools.ini"
      ],
      "matchStrings": [
        "; renovate: datasource=(?<datasource>[a-z-]+?) depName=(?:(?<depName>[a-zA-Z0-9-]+?))?\\s+(?<packageName>[^=\\s]+?)\\s*=\\s*(?<currentValue>(\\d+(\\.\\d+)*)?)"
      ]
    }
  ],
  "nuget": {
    "managerFilePatterns": ["/\\.msbuildproj$/"]
  },
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "postUpdateOptions": [
        "nugetUpdateLockFiles"
      ]
    },
    {
      "matchManagers": ["nuget"],
      "matchDatasources": ["dotnet-version"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchFileNames": ["**/global.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "enabled": false
    },
    {
      "matchManagers": ["nuget"],
      "matchDatasources": ["dotnet-version"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchFileNames": ["**/global.json"],
      "allowedVersions": "/^([1-9]?[0-9]*[02468]{1})\\.(0)\\.(0|100)$/",
      "enabled": true
    }
  ]
}
