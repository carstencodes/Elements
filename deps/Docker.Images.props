<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- renovate: datasource=docker depName=Rust-Linux-Darwin-Builder -->
    <CargoLinuxMacBaseDockerImage>joseluisq/rust-linux-darwin-builder:2.0.0-beta.1</CargoLinuxMacBaseDockerImage>
    <CargoLinuxMacDockerImage>carstencodes/elements/cargo-build-cross:ci</CargoLinuxMacDockerImage>
  </PropertyGroup>

  <ItemGroup>
    <DockerImagesToBuild Include="$(CargoLinuxMacDockerImage)"
                         BasedOn="$(CargoLinuxMacBaseDockerImage)"
                         UsingDockerFile="$(MsBuildThisFileDirectory)../build/local/docker/cargo/Dockerfile"
                         BuildArgs="--build-arg BASE_IMAGE=$(CargoLinuxMacBaseDockerImage)" />
  </ItemGroup>
</Project>
