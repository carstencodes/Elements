// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  "name": "Debian",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "./features/src/user/": {
          "username": "${localEnv:USER}",
          "uid": "${localEnv:UID}",
          "gid": "${localEnv:GID}"
        },
    "ghcr.io/devcontainers/features/git-lfs:1": {
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
          "version": "10.0",
          "installSdk": true,
          "installRuntime": true,
          "installAspNet": true
        },
    "ghcr.io/devcontainers/features/rust:1": {
          "version": "1.96.0",
          "components": [
            "rust-analyzer",
            "rust-src",
            "rustfmt",
            "clippy"
          ],
          "targets": [
            "aarch64-unknown-linux-gnu",
            "x86_64-unknown-linux-gnu",
            "aarch64-apple-darwin",
            "x86_64-apple-darwin"
          ]
        },
    "ghcr.io/lee-orr/rusty-dev-containers/cargo-audit:0": {
          "version": "0.22.2"
        },
    "ghcr.io/lee-orr/rusty-dev-containers/cargo-binstall:0": {},
    //"ghcr.io/lee-orr/rusty-dev-containers/cargo-nextest:0": {},
    "ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {
          "version": "1.3.0"
        },
    "ghcr.io/devcontainers-extra/features/zig:1": {
          "version": "0.15.2"
        },
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
          "moby": false
        }
  },
  "containerEnv": {
    "CARGO_HOME": "/home/vscode/.cargo/"
  },

  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind"],

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Configure tool-specific properties.
  // "customizations": {},

  "remoteUser": "${localEnv:USER}",

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"

  "postCreateCommand": "cat >> /home/vscode/.bashrc <<'EOF'\n\n# Cargo/Rust homes (override container defaults)\nexport CARGO_HOME=\"$HOME/.cargo\"\ncase \":$PATH:\" in\n  *\":$CARGO_HOME/bin:\"*) ;; \n  *) export PATH=\"$CARGO_HOME/bin:$PATH\" ;; \nesac\nEOF && dotnet tool restore && dotnet run $(pwd)/deps/ContainerTools.cs $(pwd)/deps/cargo-tools.ini"
}
