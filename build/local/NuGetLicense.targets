<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NuGetLicenseOutputFile>$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)/ThirdPartyInformation.txt</NuGetLicenseOutputFile>
  </PropertyGroup>

  <Target Name="GenerateNuGetLicenseOutputFile"
          DependsOnTargets="CollectNuGetAndToolsConfigFiles"
          Inputs="@(DependencyDefinitionFiles)"
          Outputs="$(NuGetLicenseOutputFile)"
          Condition="'$(MsBuildProjectExtension)' == '.csproj'">
    <MakeDir Directories="$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)" Condition="!Exists('$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)')" />

    <Exec
      Command="dotnet tool run nuget-license -i &quot;$(MsBuildProjectFullPath)&quot; -t -isp -o Table -fo &quot;$(NuGetLicenseOutputFile)&quot;"
      ContinueOnError="false"
      ConsoleToMSBuild="true"
      IgnoreStandardErrorWarningFormat="true"
      IgnoreExitCode="false" />

    <ItemGroup>
      <FileWrites Include="$(NuGetLicenseOutputFile)" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);
      PackNuGetLicenseOutputFile
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackNuGetLicenseOutputFile" Condition="'$(IsPackable)' == 'true'" DependsOnTargets="GenerateNuGetLicenseOutputFile;$(PackNuGetLicenseOutputFileDependsOn)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(NuGetLicenseOutputFile)" Condition="Exists('$(NuGetLicenseOutputFile)')">
        <PackagePath>sbom/ThirdPartyInformation.txt</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="CreateNuGetLicenseOutputFile" DependsOnTargets="GenerateNuGetLicenseOutputFile;$(CreateNuGetLicenseOutputFileDependsOn)" />
</Project>
