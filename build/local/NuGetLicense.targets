<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NuGetLicenseOutputFile>$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)/ThirdPartyInformation.txt</NuGetLicenseOutputFile>
  </PropertyGroup>

  <Target Name="GenerateNuGetLicenseOutputFile" Condition="'$(MsBuildProjectExtension)' == '.csproj'">
    <MakeDir Directories="$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)" Condition="!Exists('$(NuGetThirdPartyResultPaths)$(MsBuildProjectName)')" />

    <Exec
      Command="dotnet tool run nuget-license -i &quot;$(MsBuildProjectFullPath)&quot; -t -isp -o Table -fo &quot;$(NuGetLicenseOutputFile)&quot;"
      ContinueOnError="false"
      ConsoleToMSBuild="true"
      IgnoreStandardErrorWarningFormat="true"
      IgnoreExitCode="false" />

    <ItemGroup>
      <FilesWrites Include="$(NuGetLicenseOutputFile)" />
    </ItemGroup>
  </Target>

  <Target Name="PackNuGetLicenseOutputFile" DependsOnTargets="GenerateNuGetLicenseOutputFile;$(PackNuGetLicenseOutputFileDependsOn)" Condition="Exists('$(NuGetLicenseOutputFile)')">
    <ItemGroup>
      <None Include="$(NuGetLicenseOutputFile)" Visible="false" Pack="true" PackagePath="sbom/ThirdPartyInformation.txt" />
    </ItemGroup>
  </Target>

  <Target Name="CreateNuGetLicenseOutputFile" DependsOnTargets="GenerateNuGetLicenseOutputFile;$(CreateNuGetLicenseOutputFileDependsOn)" />

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <BeforePack>
      PackNuGetLicenseOutputFile;
      $(BeforePack)
    </BeforePack>
  </PropertyGroup>
</Project>
