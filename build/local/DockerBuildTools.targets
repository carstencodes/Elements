<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Target Name="IsDockerCliInstalled">
    <PropertyGroup>
      <DockerCheckCommand Condition="'$(OS)' == 'Windows_NT'">where docker</DockerCheckCommand>
      <DockerCheckCommand Condition="'$(OS)' != 'Windows_NT'">which docker</DockerCheckCommand>
    </PropertyGroup>

    <Exec Command="$(DockerCheckCommand)"
      ContinueOnError="warnAndContinue"
      ConsoleToMSBuild="true"
      IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="DockerFoundExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="DockerInstallLocation" />
    </Exec>

    <PropertyGroup>
      <DockerInstalled />
      <DockerInstalled Condition="'$(DockerFoundExitCode)' == '0'">True</DockerInstalled>
      <DockerInstalled Condition="'$(DockerFoundExitCode)' != '0'">False</DockerInstalled>
    </PropertyGroup>
  </Target>

  <Target Name="DockerGetImagesToBuild" Condition="'$(DockerBuildImageId)' != ''">
    <ItemGroup>
      <DockerImagesToBeBuildForProject Include="@(DockerImagesToBuild->WithMetadataValue('Identity', '$(DockerBuildImageId)'))" />
    </ItemGroup>
  </Target>

  <Target Name="DockerPullImageIfRequired" DependsOnTargets="IsDockerCliInstalled;DockerGetImagesToBuild" Condition="'$(DockerBuildImageId)' != '' AND @(DockerImagesToBeBuildForProject->Count()) == 0">
    <Exec Command="$(DockerInstallLocation) pull $(DockerBuildImageId)"
          ContinueOnError="false"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false"
          Condition="'$(DockerInstalled)' == 'True'" />
  </Target>

  <Target Name="DockerBuildImageIfRequired" DependsOnTargets="IsDockerCliInstalled;DockerGetImagesToBuild"  Condition="'$(DockerBuildImageId)' != '' AND @(DockerImagesToBeBuildForProject->Count()) &gt; 0">
    <PropertyGroup>
      <DockerBuildContext Condition="'$(DockerBuildContext)' == ''">$(SolutionDir)</DockerBuildContext>
    </PropertyGroup>

    <Exec Command="$(DockerInstallLocation) pull %(DockerImagesToBeBuildForProject.BasedOn)"
          ContinueOnError="false"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false"
          Condition="'$(DockerInstalled)' == 'True'" />

    <Exec Command="$(DockerInstallLocation) image ls -q %(DockerImagesToBeBuildForProject.Identity)"
          ContinueOnError="false"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false"
          Condition="'$(DockerInstalled)' == 'True'">
      <Output TaskParameter="ConsoleOutput" PropertyName="DockerBuildImageHashExisting" />
    </Exec>

    <Exec Command="$(DockerInstallLocation) build %(DockerImagesToBeBuildForProject.BuildArgs) -f %(DockerImagesToBeBuildForProject.UsingDockerFile) -t %(DockerImagesToBeBuildForProject.Identity) &quot;$(DockerBuildContext)&quot;"
          ContinueOnError="false"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false"
          Condition="'$(DockerInstalled)' == 'True' AND '$(DockerBuildImageHashExisting)' == ''" />
  </Target>

  <Target Name="PullDockerBuildImage" AfterTargets="Restore" Condition="'$(DockerPullOnRestore)' != 'false'" DependsOnTargets="DockerGetImagesToBuild;IsDockerCliInstalled;DockerPullImageIfRequired;DockerBuildImageIfRequired" />

  <Target Name="GetCurrentUserIdForDockerRun" Condition="'$(OS)' != 'Windows_NT' AND '$(DockerKeepUserId)' != 'false'">
    <Exec Command="id -u"
      ContinueOnError="warnAndContinue"
      ConsoleToMSBuild="true"
      IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="UserIdQueryExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="UserIdQueryOutput" />
    </Exec>

    <PropertyGroup>
      <DockerMountUserId />
      <DockerMountUserId Condition="'$(UserIdQueryExitCode)' == '0'">$(UserIdQueryOutput)</DockerMountUserId>
    </PropertyGroup>
  </Target>

  <Target Name="GetCurrentGroupIdForDockerRun" Condition="'$(OS)' != 'Windows_NT' AND '$(DockerKeepGroupId)' != 'false'">
    <Exec Command="id -g"
      ContinueOnError="warnAndContinue"
      ConsoleToMSBuild="true"
      IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="GroupIdQueryExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="GroupIdQueryOutput" />
    </Exec>

    <PropertyGroup>
      <DockerMountGroupId />
      <DockerMountGroupId Condition="'$(GroupIdQueryExitCode)' == '0'">$(GroupIdQueryOutput)</DockerMountGroupId>
    </PropertyGroup>
  </Target>

  <Target Name="GetDockerEnvironmentArgsAsEnvFile">
    <PropertyGroup>
      <DockerEnvFileFullPath>$(IntermediateOutputPath)docker.env</DockerEnvFileFullPath>
    </PropertyGroup>

    <ItemGroup>
      <DockerFileLines Include="@(DockerEnvironmentVariables->'%(Identity)=%(Value)')"/>
    </ItemGroup>

    <WriteLinesToFile File="$(DockerEnvFileFullPath)" Lines="@(DockerFileLines)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="@(DockerEnvironmentVariables->Count()) &gt; 0" />
    <Delete Files="$(DockerEnvFileFullPath)" Condition="@(DockerEnvironmentVariables->Count()) == 0" />
  </Target>

  <Target Name="RunDockerWithArguments"
          DependsOnTargets="GetCurrentUserIdForDockerRun;IsDockerCliInstalled;$(RunDockerWithArgumentsDependsOn);GetDockerEnvironmentArgsAsEnvFile"
          Condition="'$(DockerBuildImageId)' != ''"
          Inputs="@(DockerRunInputFiles)"
          Outputs="@(DockerRunOutputFiles)">
    <PropertyGroup>
      <DockerBuildContainerName Condition="'$(DockerBuildContainerName)' == ''">build_container_$([System.String]::Copy('$(MSBuildProjectName)').Replace('.', '_'))_$([System.String]::Copy('$(TargetFramework)').Replace('.', '_'))</DockerBuildContainerName>
      <DockerBuildContainerArgsList Condition="@(DockerBuildContainerArgs->Count()) &gt; 0">@(DockerBuildContainerArgs->'%(Identity)',' ')</DockerBuildContainerArgsList>
      <DockerBuildContainerMountTargetDir Condition="'$(DockerBuildContainerMountTargetDir)' == ''">/data</DockerBuildContainerMountTargetDir>
      <DockerBuildContainerMountSourceDir Condition="'$(DockerBuildContainerMountSourceDir)' == ''">$(MsBuildProjectDirectory)</DockerBuildContainerMountSourceDir>
      <DockerBuildContainerWorkingDir Condition="'$(DockerBuildContainerWorkingDir)' == ''">$(DockerBuildContainerMountTargetDir)</DockerBuildContainerWorkingDir>
      <DockerBuildContainerEntryPoint Condition="'$(DockerBuildContainerEntryPoint)' != ''">--entrypoint $(DockerBuildContainerEntryPoint)</DockerBuildContainerEntryPoint>
    </PropertyGroup>

    <PropertyGroup>
      <_DockerExecCliArgs />
      <_DockerExecCliArgs>$(_DockerExecCliArgs) run</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) --rm</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) --name $(DockerBuildContainerName)</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) --workdir $(DockerBuildContainerWorkingDir)</_DockerExecCliArgs>
      <_DockerExecCliArgs Condition="'$(DockerEnvFileFullPath)' != '' AND Exists('$(DockerEnvFileFullPath)')">$(_DockerExecCliArgs) --env-file &quot;$(DockerEnvFileFullPath)&quot;</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) -v "$(DockerBuildContainerMountSourceDir)":$(DockerBuildContainerMountTargetDir)</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) $(DockerBuildContainerEntryPoint)</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) $(DockerBuildImageId)</_DockerExecCliArgs>
      <_DockerExecCliArgs>$(_DockerExecCliArgs) $(DockerBuildContainerArgsList)</_DockerExecCliArgs>
    </PropertyGroup>

    <Exec Command="$(DockerInstallLocation) $(_DockerExecCliArgs)"
          ContinueOnError="false"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false"
          Condition="'$(DockerInstalled)' == 'True'" />
  </Target>
</Project>
